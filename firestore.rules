rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: fichas
    // Document ID: {marca}_{modelo}_{cc}_{anioDesde}-{anioHasta}
    // Fields (publicadas por herramientas/fichas/subir.py con cuenta de servicio):
    //   - marca: string (required)
    //   - modelo: string (required)
    //   - cilindraje_cc: int (required)
    //   - anio_desde: int (required)
    //   - anio_hasta: int (required)
    //   - clave: string (required)
    //   - estado: string (required, "publicada" para lectura cliente)
    //
    // Collection: catalogo
    // Document ID: {marcaSlug}
    // Fields (publicadas por herramientas/recolector/recolectar.py con cuenta de servicio):
    //   - marca: string (required)
    //   - fuentes: list (required)
    //   - modelos: list (required)
    //   - actualizado_en: string (required)
    //   - estado: string (required, "publicada" para lectura cliente)
    //
    // Collection: solicitudes
    // Document ID: {marca-modelo-cc-anio}
    // Fields:
    //   - marca: string (required, 1..60, immutable)
    //   - modelo: string (required, 1..80, immutable)
    //   - cilindraje_cc: int (required, 0..2600, immutable)
    //   - anio: int (required, 1950..2100, immutable)
    //   - clave: string (required, 0..200, immutable)
    //   - total: int (required, 1 on create, resource.data.total + 1 on update)
    //   - ultima: timestamp (required, recent <= request.time)
    //
    // Collection: reportes
    // Document ID: {fichaId_slug}__{campo_slug}
    // Fields:
    //   - ficha_id: string (required, 1..200, immutable)
    //   - clave: string (required, 0..200, immutable)
    //   - marca: string (required, 1..60, immutable)
    //   - modelo: string (required, 1..80, immutable)
    //   - cilindraje_cc: int (required, 0..2600, immutable)
    //   - campo: string (required, 1..120, immutable)
    //   - valor_reportado: string (required, 1..200, immutable)
    //   - motivo: string (required, 1..120)
    //   - total: int (required, 1 on create, resource.data.total + 1 on update)
    //   - ultima: timestamp (required, recent <= request.time)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isRecent(time) {
      return time is timestamp &&
        time > request.time - duration.value(5, 'm') &&
        time <= request.time;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function esSolicitudValida() {
      let allowed = ["marca", "modelo", "cilindraje_cc", "anio", "clave", "total", "ultima"];
      let d = request.resource.data;
      return hasOnlyAllowedFields(allowed)
        && hasRequiredFields(allowed)
        && validStringLength("marca", 1, 60)
        && validStringLength("modelo", 1, 80)
        && validStringLength("clave", 0, 200)
        && d.cilindraje_cc is int && d.cilindraje_cc >= 0 && d.cilindraje_cc <= 2600
        && d.anio is int && d.anio >= 1950 && d.anio <= 2100
        && d.total is int
        && isRecent(d.ultima);
    }

    function esReporteValido() {
      let allowed = [
        "ficha_id", "clave", "marca", "modelo", "cilindraje_cc",
        "campo", "valor_reportado", "motivo", "total", "ultima"
      ];
      let d = request.resource.data;
      return hasOnlyAllowedFields(allowed)
        && hasRequiredFields(allowed)
        && validStringLength("ficha_id", 1, 200)
        && validStringLength("clave", 0, 200)
        && validStringLength("marca", 1, 60)
        && validStringLength("modelo", 1, 80)
        && d.cilindraje_cc is int && d.cilindraje_cc >= 0 && d.cilindraje_cc <= 2600
        && validStringLength("campo", 1, 120)
        && validStringLength("valor_reportado", 1, 200)
        && validStringLength("motivo", 1, 120)
        && d.total is int
        && isRecent(d.ultima);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Biblioteca de fichas: cualquiera lee las publicadas; nadie escribe desde la app.
    // Las fichas se publican con herramientas/fichas/subir.py, que usa una cuenta de servicio.
    match /fichas/{fichaId} {
      allow read: if resource.data.estado == "publicada";
      allow write: if false;
    }

    // Catálogo oficial por marca: cualquiera lee las marcas publicadas; nadie escribe desde la app.
    // Se actualiza semanalmente con herramientas/recolector/recolectar.py con cuenta de servicio.
    match /catalogo/{marcaId} {
      allow read: if resource.data.estado == "publicada";
      allow write: if false;
    }

    // Solicitudes de fichas: la app solo puede crear una o sumarle 1 al contador.
    // Nadie las lee ni las borra desde la app; se consultan con herramientas/fichas/solicitudes.py.
    match /solicitudes/{solicitudId} {
      allow create: if esSolicitudValida() && request.resource.data.total == 1;
      allow update: if esSolicitudValida()
        && request.resource.data.total == resource.data.total + 1
        && areImmutableFieldsUnchanged(["marca", "modelo", "cilindraje_cc", "anio", "clave"]);
      allow read, delete: if false;
    }

    // Reportes de datos incorrectos en fichas publicadas: contador de solo escritura para la app.
    match /reportes/{reporteId} {
      allow create: if esReporteValido() && request.resource.data.total == 1;
      allow update: if esReporteValido()
        && request.resource.data.total == resource.data.total + 1
        && areImmutableFieldsUnchanged([
          "ficha_id", "clave", "marca", "modelo",
          "cilindraje_cc", "campo", "valor_reportado"
        ]);
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
